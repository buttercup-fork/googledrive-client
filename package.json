{
  "name": "@buttercup/googledrive-client",
  "version": "2.3.0",
  "description": "Basic client for Google Drive",
  "exports": "./dist/index.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc",
    "prepare": "husky && npm run build",
    "clean": "rimraf dist",
    "format": "prettier --write '{source,test}/**/*.{js,ts}'",
    "prepublishOnly": "npm run build",
    "test": "npm run test:unit && npm run test:format",
    "test:format": "prettier --check '{source,test}/**/*.{js,ts}'",
    "test:unit": "npm run build && c8 --src ./dist --check-coverage --lines 69 --functions 80 --branches 92 --statements 69 mocha 'test/unit/**/*.spec.js'"
  },
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "{source,test}/**/*.{js,ts}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buttercup-fork/googledrive-client.git"
  },
  "keywords": [
    "google",
    "drive",
    "client",
    "request"
  ],
  "author": "Perry Mitchell <perry@perrymitchell.net>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/buttercup/googledrive-client/issues"
  },
  "homepage": "https://github.com/buttercup/googledrive-client#readme",
  "dependencies": {
    "base64-js": "^1.5.1",
    "hot-patcher": "^2.0.1",
    "layerr": "^3.0.0",
    "url-parse": "^1.5.10"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "c8": "^12.0.0",
    "chai": "^6.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mocha": "^12.0.2",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "sinon": "^22.1.0",
    "typescript": "^6.0.3"
  }
}
